# Anything that runs on Linux must stay LF regardless of the platform it was edited on.
# A CRLF in a shell script fails in CloudShell and on the GPU nodes with a bare
# "$'\r': command not found", which gives no useful hint about the real cause.
*.sh text eol=lf
*.tpl text eol=lf

# Keep this file consistent with the rule it defines.
.gitattributes text eol=lf
